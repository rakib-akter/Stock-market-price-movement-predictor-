# Copy this file to `.env` and adjust values. `.env` is git-ignored.

# ---- Database ----
# SQLite (default, zero-config). For PostgreSQL use:
#   DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/quant
DATABASE_URL=sqlite:///./quant.db

# ---- Data ----
DEFAULT_TICKERS=AAPL,MSFT,GOOGL,AMZN,NVDA
MARKET_BENCHMARKS=SPY,QQQ
DATA_START_DATE=2015-01-01
DATA_INTERVAL=1d

# ---- Demo mode ----
# DEMO_MODE=true uses deterministic SYNTHETIC data so the app runs fully offline
# with no API keys (great for a first run / demo). Set to false for live yfinance.
DEMO_MODE=true
# If a live fetch fails (e.g. no internet) and DEMO_MODE=false, fall back to demo
# data instead of erroring out.
DEMO_FALLBACK=true

# ---- Modeling ----
PREDICTION_HORIZON_DAYS=1        # 1 = next-day direction (recommended first target)
TEST_SIZE=0.2                    # fraction of (time-ordered) data held out for testing
RANDOM_SEED=42

# ---- Backtesting ----
TRANSACTION_COST_BPS=5           # round-trip cost in basis points (5 = 0.05%)
SLIPPAGE_BPS=2                   # assumed slippage per trade in basis points
INITIAL_CAPITAL=10000

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
